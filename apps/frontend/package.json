{
  "name": "sova-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "NEXT_PUBLIC_E2E=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:staging": "playwright test acceptance guard smoke",
    "baseline": "playwright test -c playwright.baseline.config.ts capture.spec",
    "baseline:compare": "playwright test -c playwright.baseline.config.ts compare.spec",
    "baseline:hash": "playwright test -c playwright.baseline.config.ts source-hash.spec",
    "baseline:sova": "BASELINE_SOVA=1 playwright test -c playwright.baseline.config.ts sova.spec home.spec",
    "import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import/index.ts",
    "port:css": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/port-css.ts",
    "check:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-brand.ts",
    "check:components": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-components.ts",
    "copy:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assets.ts",
    "verify:assets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/assets.ts --verify"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-tabs": "1.1.22",
    "embla-carousel": "8.6.0",
    "embla-carousel-auto-height": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
