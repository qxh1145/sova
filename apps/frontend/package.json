{
  "name": "sova-landing-page",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "baseline": "playwright test -c playwright.baseline.config.ts capture.spec",
    "baseline:compare": "playwright test -c playwright.baseline.config.ts compare.spec",
    "baseline:hash": "playwright test -c playwright.baseline.config.ts source-hash.spec",
    "baseline:sova": "BASELINE_SOVA=1 playwright test -c playwright.baseline.config.ts sova.spec",
    "import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import/index.ts",
    "port:css": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/port-css.ts",
    "check:brand": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-brand.ts",
    "check:components": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-components.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "10.1.8",
    "node-html-parser": "9.0.4",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
